[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/archive/archive_screen.gd" id="1_archive"]

[node name="ArchiveScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_archive")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="ContentContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="CenterContainer/ContentContainer"]
layout_mode = 2
text = "기록 보관실"
horizontal_alignment = 1
vertical_alignment = 1

[node name="EmptyLabel" type="Label" parent="CenterContainer/ContentContainer"]
layout_mode = 2
text = "아직 해금된 기록이 없습니다."
horizontal_alignment = 1
vertical_alignment = 1

[node name="ArchiveListTitleLabel" type="Label" parent="CenterContainer/ContentContainer"]
layout_mode = 2
text = "해금된 기록"
horizontal_alignment = 1
vertical_alignment = 1

[node name="ArchiveListContainer" type="VBoxContainer" parent="CenterContainer/ContentContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DescriptionLabel" type="Label" parent="CenterContainer/ContentContainer"]
custom_minimum_size = Vector2(420, 60)
layout_mode = 2
text = "회차 종료 후 확인된 이상현상 정보가 이곳에 보관됩니다."
