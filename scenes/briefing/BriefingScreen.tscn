[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/briefing/briefing_screen.gd" id="1_briefing"]

[node name="BriefingScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_briefing")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="BriefingContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="CenterContainer/BriefingContainer"]
layout_mode = 2
text = "브리핑"
horizontal_alignment = 1
vertical_alignment = 1

[node name="BodyLabel" type="Label" parent="CenterContainer/BriefingContainer"]
custom_minimum_size = Vector2(420, 80)
layout_mode = 2
text = "금일 신규 보고는 없습니다."
horizontal_alignment = 1
vertical_alignment = 1

[node name="StartWorkButton" type="Button" parent="CenterContainer/BriefingContainer"]
custom_minimum_size = Vector2(240, 40)
layout_mode = 2
text = "근무 시작"

[connection signal="pressed" from="CenterContainer/BriefingContainer/StartWorkButton" to="." method="_on_start_work_button_pressed"]
