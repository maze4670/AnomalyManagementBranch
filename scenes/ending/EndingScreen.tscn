[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/ending/ending_screen.gd" id="1_ending"]

[node name="EndingScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ending")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="ContentContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="CenterContainer/ContentContainer"]
layout_mode = 2
text = "근무 종료"
horizontal_alignment = 1
vertical_alignment = 1

[node name="BodyLabel" type="Label" parent="CenterContainer/ContentContainer"]
custom_minimum_size = Vector2(420, 80)
